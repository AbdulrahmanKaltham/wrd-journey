rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow reading profile (authenticated users can read their own or circle members)
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;

      // Secure updates: User can update their document only if auth matches,
      // and XP increase is bounded (max 200 per update), and week jump is bounded (max +1).
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (
          !('xp' in resource.data) ||
          request.resource.data.xp >= resource.data.xp &&
          (request.resource.data.xp - resource.data.xp) <= 200
        )
        && (
          !('currentWeek' in resource.data) ||
          request.resource.data.currentWeek <= resource.data.currentWeek + 1
        );
    }

    match /circles/{circleId} {
      // Authenticated users can read circles
      allow read: if request.auth != null;
      // Teachers can create and manage their circles
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }
  }
}
